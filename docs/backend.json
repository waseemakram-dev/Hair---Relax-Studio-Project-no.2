{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "Represents a service offered by the salon.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the service."
        },
        "price": {
          "type": "number",
          "description": "The price of the service."
        }
      },
      "required": ["name", "price"]
    },
    "Product": {
      "title": "Product",
      "description": "Represents a product sold by the salon.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the product."
        },
        "price": {
          "type": "number",
          "description": "The price of the product."
        },
        "stock": {
          "type": "number",
          "description": "The stock quantity of the product."
        },
        "lowStockThreshold": {
          "type": "number",
          "description": "The threshold below which stock is considered low."
        }
      },
      "required": ["name", "price", "stock"]
    },
    "Worker": {
      "title": "Worker",
      "description": "Represents a worker/portion in the salon.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the worker/portion."
        },
        "customers": {
          "type": "number",
          "description": "The number of customers served."
        },
        "sales": {
          "type": "number",
          "description": "The total sales amount."
        }
      },
      "required": ["name"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Represents a customer sale.",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string"
        },
        "workerId": {
          "type": "string"
        },
        "serviceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "productIds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "quantity": { "type": "number" }
            }
          }
        },
        "discount": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["customerName", "workerId", "total", "createdAt"]
    }
  },
  "auth": {
    "providers": ["anonymous", "email-password"]
  },
  "firestore": {
    "/services": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Collection of all services."
    },
    "/products": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Collection of all products."
    },
    "/workers": {
      "schema": { "$ref": "#/entities/Worker" },
      "description": "Collection of all workers."
    },
    "/sales": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Collection of all sales."
    }
  }
}
